# Server Configuration
PORT=10000
NODE_ENV=development

# Database
# MongoDB Atlas (Cloud Database) - REQUIRED
# Format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/database_name?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/elearning?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Meeting / Video Conference Configuration (Optional - Defaults to Jitsi)
MEETING_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

# IMPORTANT: The public 'meet.jit.si' server does NOT trust custom JWT signatures. 
# Therefore, using the default public server requires the teacher to manually log in 
# once in the Jitsi iframe to become a moderator (this is a public platform limitation).
# To enable automated moderator login, you must configure a self-hosted Jitsi instance 
# or an 8x8 JaaS account below:
JITSI_JWT_SECRET=your_jitsi_jwt_signing_secret_key
JITSI_APP_ID=your_jitsi_application_identifier

# WhatsApp Business Platform Cloud API Configuration
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=mock_your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=mock_your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_for_meta_webhooks
WHATSAPP_API_VERSION=v19.0
WHATSAPP_DEFAULT_COUNTRY_CODE=+91

